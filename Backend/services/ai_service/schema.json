{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkoutGenerationResponse",
  "type": "object",
  "properties": {
    "workout_name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "type": { "type": "string", "enum": ["strength", "cardio", "yoga"] },
    "duration_min": { "type": "integer", "minimum": 5, "maximum": 120 },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "exercise_id": { "type": "string" },
          "exercise_type": { "type": "string", "enum": ["strength", "cardio", "yoga"] },
          "sets": { "type": ["integer", "null"], "minimum": 1, "maximum": 10 },
          "reps": { "type": ["integer", "null"], "minimum": 1, "maximum": 50 },
          "weight_kg": { "type": ["number", "null"], "minimum": 0, "maximum": 300 },
          "duration_minutes": { "type": ["integer", "null"], "minimum": 1, "maximum": 120 },
          "pace": { "type": ["string", "null"], "enum": ["walk", "jog", "run", "sprint", "recovery"] },
          "hold_seconds": { "type": ["integer", "null"], "minimum": 5, "maximum": 300 },
          "breath_count": { "type": ["integer", "null"], "minimum": 1, "maximum": 20 },
          "note": { "type": ["string", "null"], "maxLength": 200 }
        },
        "required": ["exercise_id", "exercise_type"],
        "additionalProperties": false,
        "if": { "properties": { "exercise_type": { "const": "strength" } } },
        "then": {
          "required": ["sets", "reps"]
        },
        "else": {
          "if": { "properties": { "exercise_type": { "const": "cardio" } } },
          "then": {
            "required": ["duration_minutes", "pace"]
          },
          "else": {
            "if": { "properties": { "exercise_type": { "const": "yoga" } } },
            "then": {
              "required": ["hold_seconds", "breath_count"]
            }
          }
        }
      }
    }
  },
  "required": ["workout_name", "type", "duration_min", "exercises"],
  "additionalProperties": false
}